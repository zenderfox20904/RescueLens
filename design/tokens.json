{
  "$comment": "RescueLens shared design tokens. Source of truth for web (frontend/src/styles/tokens.css) and Flutter (mobile/lib/theme/tokens.dart). Palette follows Facebook/Meta UI conventions.",
  "color": {
    "light": { "primary": "#1877F2", "primaryHover": "#166FE5", "bg": "#F0F2F5", "card": "#FFFFFF", "text": "#050505", "textSecondary": "#65676B", "divider": "#CED0D4", "hover": "#F2F2F2", "input": "#F0F2F5" },
    "dark":  { "primary": "#2D88FF", "primaryHover": "#4599FF", "bg": "#18191A", "card": "#242526", "text": "#E4E6EB", "textSecondary": "#B0B3B8", "divider": "#3A3B3C", "hover": "#3A3B3C", "input": "#3A3B3C" },
    "gradient": { "from": "#0064E0", "to": "#0081FB" },
    "status": { "danger": "#E41E3F", "warning": "#F7B928", "success": "#31A24C", "info": "#1877F2" },
    "severity": { "low": "#31A24C", "moderate": "#F7B928", "high": "#F5793B", "critical": "#E41E3F" }
  },
  "radius": { "card": 8, "button": 6, "pill": 999, "avatar": 999 },
  "font": { "family": "Segoe UI Historic, Segoe UI, Helvetica, Arial, Noto Sans Bengali, sans-serif", "sizeBase": 15 },
  "shadow": { "card": "0 1px 2px rgba(0,0,0,0.2)" }
}
