APP_NAME=RescueLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rescuelens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RescueLens
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Meta Model API. Leave META_MODEL_API_KEY empty to run in clearly labeled DEMO mode.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_DAILY_BUDGET=500
AI_ENABLE_SEGMENTATION=true
RL_PUBLIC_LOCATION_DECIMALS=3
RL_DUPLICATE_RADIUS_M=300
RL_DUPLICATE_WINDOW_HOURS=3
RL_STALE_HOURS=12
RL_UPLOAD_MAX_KB=8192

# Social login (see docs/SOCIAL_LOGIN_SETUP.md). Leave empty to show "not configured".
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Partner webhooks (comma separated HTTPS URLs) signed with HMAC SHA256
RL_WEBHOOK_URLS=
RL_WEBHOOK_SECRET=

# Optional Facebook Page posting (disabled by default, moderator confirm only)
FB_PAGE_POSTING_ENABLED=false
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v24.0
RATE_LIMIT_API_PER_MIN=120
AI_REASONING_EFFORT=high
AI_TEMPERATURE=0.2
HASH_DRIVER=argon2id
# Allows legacy bcrypt hashes to verify; they are rehashed with Argon2id on next login
HASH_VERIFY=false

# Local demo system admin, created by the seeder. Never use in production.
SYSTEM_ADMIN_EMAIL=sysadmin@rescuelens.test
SYSTEM_ADMIN_PASSWORD=change_me_locally

# CCTV / camera feeds: https hosts allowed for snapshot URLs (comma separated). Empty disables URL feeds.
CAMERA_ALLOWED_HOSTS=
CAMERA_MIN_CONFIDENCE=0.7

# DEV ONLY, temporary: AI_PROVIDER=ollama uses a local Ollama model instead of Meta. Ignored in production.
AI_PROVIDER=meta
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
